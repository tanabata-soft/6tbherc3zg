 "gospel": [
  {
   "startMs": 22752,
   "endMs": 31062,
   "text": "谷底の 霧の中"
  },
  {
   "startMs": 31062,
   "endMs": 37099,
   "text": "ひとり歩いた 木曽の朝"
  },
  {
   "startMs": 37099,
   "endMs": 43856,
   "text": "祈る言葉も 見つからず"
  },
  {
   "startMs": 43856,
   "endMs": 52875,
   "text": "そこに立ってた ニコラス・ケイジ"
  },
  {
   "startMs": 52875,
   "endMs": 59000,
   "text": "「なんでいるの」と 聞けなくて"
  },
  {
   "startMs": 59000,
   "endMs": 65422,
   "text": "並んで歩く 石畳"
  },
  {
   "startMs": 65422,
   "endMs": 71160,
   "text": "彼は叫ぶ 木曽は黙る"
  },
  {
   "startMs": 71160,
   "endMs": 79315,
   "text": "私はただ あいだにいる"
  },
  {
   "startMs": 79315,
   "endMs": 85709,
   "text": "木曽川は 今日も流れてる"
  },
  {
   "startMs": 85709,
   "endMs": 92331,
   "text": "叫ぶ男も 黙る山も"
  },
  {
   "startMs": 92331,
   "endMs": 99929,
   "text": "私のことも 洗いながら"
  },
  {
   "startMs": 99929,
   "endMs": 105472,
   "text": "ニコラス・ケイジと 木曽と私 (Hallelujah!)"
  },
  {
   "startMs": 105472,
   "endMs": 112675,
   "text": "叫ぶ人と 待つ山と (Hallelujah!)"
  },
  {
   "startMs": 112675,
   "endMs": 118193,
   "text": "ニコラス・ケイジと 木曽と私 (Hallelujah!)"
  },
  {
   "startMs": 118193,
   "endMs": 124285,
   "text": "谷底にも 朝が来る (朝が来る!)"
  }
 ],
 "kira": [
  {
   "startMs": 13968,
   "endMs": 19519,
   "text": "昼の十二時 木曽福島"
  },
  {
   "startMs": 19519,
   "endMs": 25880,
   "text": "改札の前で 待ち合わせ"
  },
  {
   "startMs": 25880,
   "endMs": 32349,
   "text": "サングラスの彼は 時刻表を逆さに持って"
  },
  {
   "startMs": 32349,
   "endMs": 38319,
   "text": "「次のバスは？」と 笑ってる"
  },
  {
   "startMs": 38319,
   "endMs": 41944,
   "text": "木曽馬に会いたいと 言い出して"
  },
  {
   "startMs": 41944,
   "endMs": 45151,
   "text": "予定がぜんぶ 変わってく"
  },
  {
   "startMs": 45151,
   "endMs": 48751,
   "text": "私はいつも 地図を見て"
  },
  {
   "startMs": 48751,
   "endMs": 52390,
   "text": "ケイジは いつも 風を見る"
  },
  {
   "startMs": 52390,
   "endMs": 55558,
   "text": "バスは一日 数えるほど"
  },
  {
   "startMs": 55558,
   "endMs": 59180,
   "text": "それでもなぜか 焦らない"
  },
  {
   "startMs": 59180,
   "endMs": 64101,
   "text": "Hey, hey, 今日はどこまで行こうか"
  },
  {
   "startMs": 64101,
   "endMs": 70447,
   "text": "ニコラス・ケイジと 木曽と私"
  },
  {
   "startMs": 70447,
   "endMs": 77791,
   "text": "終バスは もう行った"
  },
  {
   "startMs": 77791,
   "endMs": 81692,
   "text": "Cage and Kiso and me"
  },
  {
   "startMs": 81692,
   "endMs": 90358,
   "text": "Tonight we walk, 木曽川沿い"
  },
  {
   "startMs": 90358,
   "endMs": 93761,
   "text": "温泉の湯気で サングラスが曇る"
  },
  {
   "startMs": 93761,
   "endMs": 96952,
   "text": "湯上がりに とうもろこしソフト"
  },
  {
   "startMs": 96952,
   "endMs": 100568,
   "text": "五平餅を 半分こして"
  },
  {
   "startMs": 100568,
   "endMs": 102995,
   "text": "御嶽山に 夕日が落ちる"
  },
  {
   "startMs": 102995,
   "endMs": 106137,
   "text": "バス停のベンチ ヒノキの香り"
  },
  {
   "startMs": 106137,
   "endMs": 109374,
   "text": "時刻表を 三回読んだ"
  },
  {
   "startMs": 109374,
   "endMs": 112573,
   "text": "次のバスは 明日の朝"
  },
  {
   "startMs": 112573,
   "endMs": 117981,
   "text": "「じゃあ 歩こう」と 彼が言う"
  }
 ]
}
