  },
  {
   "startMs": 110188,
   "endMs": 113750,
   "text": "Is this real or just a fantasy"
  },
  {
   "startMs": 113750,
   "endMs": 117312,
   "text": "Kiso no yoru ni somaru"
  },
  {
   "startMs": 117312,
   "endMs": 120875,
   "text": "A Hollywood persona by my side"
  },
  {
   "startMs": 120875,
   "endMs": 124438,
